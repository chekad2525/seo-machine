{
  "name": "@seo-machine/api",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "npm --prefix ../.. run db:generate && npm --prefix ../.. run build -w @seo-machine/db && npm --prefix ../.. run db:migrate:deploy",
    "build": "nest build --path tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@seo-machine/db": "0.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  }
}
