# SEO Machine public app on Cloudflare Workers (app.seomachine.ir).
# Copy to .env.seomachine; never commit the filled file.
AUTH_MODE=hosted
DATABASE_PROVIDER=d1
BETTER_AUTH_URL=https://app.seomachine.ir

# Required before public signup, billing, and SEO data requests.
BETTER_AUTH_SECRET=
DATAFORSEO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOOPS_API_KEY=
LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=
LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=
LOOPS_TRANSACTIONAL_INVITATION_ID=
AUTUMN_SECRET_KEY=
AUTUMN_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_SUPPORT_EMAIL=seomachine@info.ir

# Optional integrations.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
